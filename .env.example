# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_AUTH_URL=

# Backend Environment
PORT=3001
NODE_ENV=development

# Database Configuration (Section 7)
MONGODB_URI=mongodb://admin:adminpassword@localhost:27017/invitation_platform?authSource=admin
MONGODB_DB_NAME=invitation_platform

# Authentication Configuration (Section 5)
AUTH_SECRET=development_secret_key_change_in_production
AUTH_ISSUER=https://auth.example.com

# Cloudflare R2 Storage (Section 20)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=invitation-platform-assets
R2_PUBLIC_URL=https://assets.example.com
